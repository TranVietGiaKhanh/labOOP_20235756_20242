package hust.soict.hedspi.test.disc;

import hust.soict.hedspi.aims.media.DigitalVideoDisc;

public class TestPassingParameter {
	public static void main(String[] args) {
        DigitalVideoDisc jungleDVD = new DigitalVideoDisc("Jungle");
        DigitalVideoDisc cinderellaDVD = new DigitalVideoDisc("Cinderella");

        swap(jungleDVD, cinderellaDVD);
        System.out.println("jungle dvd title: " + jungleDVD.getTitlte());
        System.out.println("cinderella dvd title: " + cinderellaDVD.getTitlte());

        changeTitle(jungleDVD, cinderellaDVD.getTitlte());
        System.out.println("jungle dvd title: " + jungleDVD.getTitlte());
    }

    public static void swap(Object o1, Object o2) {
        Object tmp = o1;
        o1 = o2;
        o2 = tmp;
    }

    public static void changeTitle(DigitalVideoDisc dvd, String title) {
        String oldTitle = dvd.getTitlte();
        dvd = new DigitalVideoDisc(title);
        dvd = new DigitalVideoDisc(oldTitle);
    }
}
