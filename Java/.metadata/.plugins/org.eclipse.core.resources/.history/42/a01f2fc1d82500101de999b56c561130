package hust.soict.hedspi.aims.screen.manager;
import hust.soict.hedspi.aims.store.Store;
import javax.swing.*;
import java.awt.*;

public class AddDigitalVideoDiscToStoreScreen extends AddItemToStoreScreen{
	private JTextField tfDirector, tfLength;

    public AddDigitalVideoDiscToStoreScreen(Store store) {
        super(store);
        setTitle("Add DVD");
        setSize(400, 300);
        setVisible(true);
    }

    @Override
    protected JPanel createForm() {
        JPanel form = new JPanel(new GridLayout(6, 2, 5, 5));
        form.add(new JLabel("ID:"));       form.add(tfID       = new JTextField());
        form.add(new JLabel("Title:"));    form.add(tfTitle    = new JTextField());
        form.add(new JLabel("Category:")); form.add(tfCategory = new JTextField());
        form.add(new JLabel("Cost:"));     form.add(tfCost     = new JTextField());
        form.add(new JLabel("Director:")); form.add(tfDirector = new JTextField());
        form.add(new JLabel("Length:"));   form.add(tfLength   = new JTextField());

        btnAdd = new JButton("Add");
        btnAdd.addActionListener(e -> {
            DigitalVideoDisc dvd = new DigitalVideoDisc(
                tfTitle.getText(),
                tfCategory.getText(),
                tfDirector.getText(),
                Integer.parseInt(tfLength.getText()),
                Float.parseFloat(tfCost.getText())
            );
            store.addMedia(dvd);
            JOptionPane.showMessageDialog(this, "DVD added!");
        });

        JPanel wrapper = new JPanel(new BorderLayout());
        wrapper.add(form, BorderLayout.CENTER);
        JPanel south = new JPanel();
        south.add(btnAdd);
        wrapper.add(south, BorderLayout.SOUTH);
        return wrapper;
    }
}
